# Environment / secrets — never commit real credentials
.env

# Composer dependencies — reinstalled from composer.lock on every deploy
/vendor/

# CI4 writable state — logs, cache, sessions regenerate at runtime
/writable/cache/*
!/writable/cache/index.html
/writable/debugbar/*
!/writable/debugbar/index.html
/writable/logs/*
!/writable/logs/index.html
/writable/session/*
!/writable/session/index.html

# User-uploaded files — not source, and (once Cloudinary is configured)
# not where new uploads land anyway
/public/uploads/avatars/*
!/public/uploads/avatars/index.html
/public/uploads/products/*
!/public/uploads/products/index.html

# OS/editor noise
.DS_Store
Thumbs.db
.vscode/
.idea/
